{
  "name": "mvtech-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:content && npm run build:css && npm run build:icons",
    "build:content": "node scripts/build.mjs",
    "build:css": "esbuild css/input.css --minify --outfile=css/site.css --log-level=warning",
    "build:icons": "esbuild js/icons-entry.js --bundle --minify --format=iife --outfile=js/icons.js --log-level=warning",
    "build:og": "node scripts/build-og.mjs",
    "test": "npm run check",
    "check": "node scripts/check-site.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide": "0.468.0",
    "parse5": "8.0.1",
    "playwright-core": "^1.56.1"
  }
}
