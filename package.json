{
  "name": "mvtech-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:icons",
    "build:css": "tailwindcss -c tailwind.config.js -i css/input.css -o css/site.css --minify",
    "build:icons": "esbuild js/icons-entry.js --bundle --minify --format=iife --outfile=js/icons.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide": "0.468.0",
    "tailwindcss": "3.4.17"
  }
}
